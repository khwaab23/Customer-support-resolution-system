DB_HOST=localhost
DB_PORT=5432
DB_NAME=techdemo
DB_USER=your_database_user
DB_PASSWORD=your_database_password
APP_ENVIRONMENT=development
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480

DB_HOST=localhost
DB_PORT=5432
DB_NAME=techdemo
DB_USER=your_database_user
DB_PASSWORD=your_database_password
APP_ENVIRONMENT=development
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8001,http://127.0.0.1:8001
# Required for live policy ingestion/retrieval only. Never commit a real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_COLLECTION_NAME=techdemo_policy_chunks
RAG_PERSIST_DIRECTORY=.chroma
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RETRIEVAL_TOP_K=5
OPENAI_AGENT_MODEL=gpt-4.1-mini
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_TOOL_CALLS=8
AGENT_TOOL_OUTPUT_MAX_CHARS=12000
AGENT_REQUEST_TIMEOUT_SECONDS=20
AGENT_MAX_OUTPUT_TOKENS=1200
# Development only. Logs diagnostic codes, never prompts, credentials, or tool payloads.
AGENT_DIAGNOSTICS_ENABLED=false
WORKFLOW_CHECKPOINT_SCHEMA=techdemo_workflow
WORKFLOW_RECURSION_LIMIT=12
# Development-only; allows the verification CLI to resume a paused review safely.
WORKFLOW_DEV_REVIEW_SIMULATION_ENABLED=false
# Required only when explicitly running scripts/seed_development_accounts.py.
DEV_SEED_CUSTOMER_PASSWORD=replace-with-a-development-only-password
DEV_SEED_ADMIN_EMAIL=admin@example.test
DEV_SEED_ADMIN_PASSWORD=replace-with-a-development-only-password

